// Niri configuration for this dotfiles setup.

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
    }
}

spawn-at-startup "sh" "-c" "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP && systemctl --user start niri-session.target"
spawn-at-startup "dms" "run"

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

// DMS Include Configs
include "dms/cursor.kdl"
include "dms/layout.kdl"
include "dms/binds.kdl"
include "dms/outputs.kdl"
